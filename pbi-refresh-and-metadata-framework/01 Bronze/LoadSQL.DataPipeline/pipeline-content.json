              },
              "schema": [],
              "externalReferences": {
                "connection": {
                  "value": "@pipeline().parameters.ConnectionID",
                  "type": "Expression"
                }
              },
              "annotations": []
            }
          },
          "sink": {
            "type": "ParquetSink",
            "formatSettings": {
              "type": "ParquetWriteSettings"
            },
            "storeSettings": {
              "type": "LakehouseWriteSettings"
            },
            "datasetSettings": {
              "type": "Parquet",
              "typeProperties": {
