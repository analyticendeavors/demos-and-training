                    "value": "@if(empty(pipeline().parameters.FileName), concat(pipeline().parameters.SourceTableName, '.parquet'), pipeline().parameters.FileName)",
                    "type": "Expression"
                  }
                },
                "compressionCodec": "snappy"
              },
              "schema": [],
