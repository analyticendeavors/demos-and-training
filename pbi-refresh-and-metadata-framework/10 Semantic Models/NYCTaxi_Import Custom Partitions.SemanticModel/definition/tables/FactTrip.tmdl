table FactTrip
	lineageTag: 0a147890-20f4-41f4-9654-85781018da9e

	measure 'Trip Count' = COUNTROWS(FactTrip)
		formatString: #,##0

	measure 'Total Fare' = SUM(FactTrip[FareAmount])
		formatString: $#,##0.00

	measure 'Total Tips' = SUM(FactTrip[TipAmount])
		formatString: $#,##0.00

	measure 'Total Revenue' = SUM(FactTrip[TotalAmount])
		formatString: $#,##0.00

	measure 'Average Trip Distance' = AVERAGE(FactTrip[TripDistance])
		formatString: #,##0.00

